# Copy this file to "frontend/.env" only when the API is NOT served from the
# same origin as this app.

# Leave REACT_APP_API_BASE_URL unset (or empty) for:
#   - `npm start` - the dev-server proxy in package.json forwards /api/* to
#     http://127.0.0.1:8001
#   - Vercel - vercel.json rewrites /api/* and /uploads/* to the backend service
# Create React App bakes this value into the built bundle, so a build published
# on Vercel must never point at localhost.
# REACT_APP_API_BASE_URL=http://192.168.1.20:8001
