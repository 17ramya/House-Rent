# Copy this file to "backend/.env" for local development - `dotenv` in
# backend/index.js reads it. On Vercel the same names are set as the project's
# Environment Variables, so nothing secret is ever committed.

# --- Database -----------------------------------------------------------------
# Locally the app uses MongoDB. A deployment (Vercel) does not have to: unless
# USE_SIMPLE_DB=false, it runs on the built-in "simple database" - a JSON-file
# store seeded with an admin account - so sign up, sign in and the admin pages
# work with no connection string (see "Simple database" in README.md).

# MongoDB connection string (backend/config/connect.js). Only needed locally, or
# on a deployment when USE_SIMPLE_DB=false.
# The deployment needs a hosted, publicly reachable MongoDB, e.g. MongoDB Atlas
# with your current IP allowed or 0.0.0.0/0: a Vercel Function cannot reach a
# mongod running on your laptop.
MONGO_DB=mongodb+srv://<user>:<password>@<cluster>/<database>

# "true"  - always use the built-in simple database (no MongoDB).
# "false" - always use MongoDB (the MONGO_DB below).
# unset   - MongoDB locally, the simple database on a deployment (Vercel).
# USE_SIMPLE_DB=true

# Where the simple database keeps its JSON files. Default: backend/data locally,
# /tmp/renteasy-db on Vercel. On Vercel only /tmp is writable and it is emptied
# when an instance is recycled - see "Simple database" in README.md.
# SIMPLE_DB_DIR=/tmp/renteasy-db

# The admin account the simple database is seeded with (defaults shown).
# ADMIN_EMAIL=admin@renteasy.com
# ADMIN_PASSWORD=Admin@123
# ADMIN_NAME=Site Admin

# --- Secrets ------------------------------------------------------------------
# Secret that signs and verifies the login tokens
# (backend/controllers/userController.js and backend/middlewares/authMiddlware.js).
JWT_KEY=change-me-to-a-long-random-string

# Optional. Where uploaded property photos are written
# (backend/config/uploads.js) and served from under /uploads/... .
# Defaults to backend/uploads. On Vercel only /tmp is writable, and /tmp is
# emptied whenever the function is recycled - see "Uploaded photos" in
# README.md before enabling this on a deployment.
# UPLOAD_DIR=/tmp/uploads

